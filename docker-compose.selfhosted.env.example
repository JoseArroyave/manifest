# Copy this file to `.env` next to docker-compose.selfhosted.yml, then run:
#   docker compose -f docker-compose.selfhosted.yml up -d --build

# ─── Required ──────────────────────────────────────────────────────────────
# Session signing secret. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# ─── Recommended ───────────────────────────────────────────────────────────
# At-rest encryption key for stored provider/OAuth credentials. Keep it
# SEPARATE from BETTER_AUTH_SECRET. Generate with: openssl rand -hex 32
# MANIFEST_ENCRYPTION_KEY=

# ─── Networking ────────────────────────────────────────────────────────────
# App port (host + container). Default: 2099.
# PORT=2099
# Bind beyond localhost only when you want LAN/public access.
# HOST_BIND_ADDRESS=0.0.0.0
# HOST_PORT=2099
# Set to your public URL when exposing the instance (e.g. https://manifest.example.com)
# BETTER_AUTH_URL=http://localhost:2099
# Silence the HSTS warning on plain-HTTP LAN installs.
# MANIFEST_DISABLE_HSTS=1

# ─── Database ──────────────────────────────────────────────────────────────
# Harden the bundled Postgres password: set BOTH and keep them in agreement.
# Percent-encode special chars in DATABASE_URL (@ -> %40, : -> %3A, / -> %2F).
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://manifest:change-me@postgres:5432/manifest

# ─── Local LLM servers (optional) ──────────────────────────────────────────
# Reach a host-installed Ollama / LM Studio / OpenAI-compatible server.
# OLLAMA_HOST=http://host.docker.internal:11434

# ─── Telemetry (optional, opt-out) ─────────────────────────────────────────
# MANIFEST_TELEMETRY_DISABLED=1
